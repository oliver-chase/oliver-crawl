#!/usr/bin/env bash
# OliverCode — Pre-Commit Hook (Private Repos)
# Applies to private/internal repositories. 4 gates.
# Private repos contain personal data by design — no PII gate.
# Master source: <vault-root>/Oliver/Project Repos/OliverCode/core/templates/project/pre-commit-private
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git -C "$HOOK_DIR" rev-parse --show-toplevel)"
STAGED_FILES=$(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACM)
cd "$REPO_ROOT"

VIOLATIONS=0

# ─── Gate 1: Secrets ──────────────────────────────────────────────────────────
# Block commits containing API keys, tokens, JWTs, private keys.
echo "[pre-commit] Gate 1/4: Secret scan..."

SECRET_PATTERNS=(
  '[A-Za-z0-9_]{20,}:[A-Za-z0-9_\-]{30,}'   # Colon-separated tokens (bot tokens)
  'sk-[A-Za-z0-9]{20,}'                        # OpenAI/Anthropic-style keys
  'ghp_[A-Za-z0-9]{36}'                        # GitHub personal access tokens
  'eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+'  # JWT tokens
  '(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}'   # AWS access key id -- a bare AKIA... has no secret-named var to catch it
  'xox[baprs]-[0-9A-Za-z-]{10,}'               # Slack tokens (hyphens, so the alnum rule below misses them)
  '(sk|rk)_live_[0-9A-Za-z]{20,}'              # Stripe LIVE keys (underscore, not the sk- shape above). test keys deliberately allowed -- they appear in docs
  'AIza[0-9A-Za-z_-]{35}'                      # Google API key
  'npm_[0-9A-Za-z]{36}'                        # npm access token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'         # Private keys (RSA/EC/DSA/OPENSSH/PKCS8) — matches "BEGIN <TYPE> PRIVATE KEY"
  '(TOKEN|SECRET|KEY|PASSWORD|PASSWD|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|AUTH|CREDENTIAL|token|secret|key|password|passwd|api_?key|access_?key|auth|credential)["'\'':= ]+[A-Za-z0-9]{20,}'  # Secret-named var assigned a 20+ char alphanumeric value (a bare hex-blob pattern false-positives on every git SHA/lockfile hash)
)

for pattern in "${SECRET_PATTERNS[@]}"; do
  if [ -n "$STAGED_FILES" ]; then
    while IFS= read -r file; do
      case "$file" in
        *.env.example|*mock*|tests/*|*/tests/*|*.test.*|*_test.*|*__tests__*|.gitignore) continue ;;
      esac
      if grep -nE -e "$pattern" "$file" 2>/dev/null; then
        echo "  BLOCKED: $file matches secret pattern: $pattern"
        VIOLATIONS=$((VIOLATIONS + 1))
      fi
    done <<< "$STAGED_FILES"
  fi
done

if [ $VIOLATIONS -gt 0 ]; then
  echo ""
  echo "=========================================="
  echo "COMMIT BLOCKED: $VIOLATIONS potential secret leak(s) found."
  echo "If this is a false positive (test data, example), rename to match the tests/*.test.* skip patterns above or use --no-verify."
  echo "=========================================="
  exit 1
fi

echo "  Gate 1 passed."

# ─── Gate 2: Icons / Emojis ───────────────────────────────────────────────────
# Block ALL emojis and Unicode icons. Plain text only. No exceptions.
# This applies to private repos too — the no-icons rule is universal.
echo "[pre-commit] Gate 2/4: Icon/Emoji scan..."

EMOJI_PATTERN='[\x{1F600}-\x{1F64F}\x{1F300}-\x{1F5FF}\x{1F680}-\x{1F6FF}\x{1F1E0}-\x{1F1FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}\x{FE00}-\x{FE0F}\x{1F900}-\x{1F9FF}\x{1FA00}-\x{1FA6F}\x{1FA70}-\x{1FAFF}\x{2300}-\x{23FF}\x{2B50}\x{2764}\x{1F004}\x{1F0CF}\x{2934}-\x{2935}\x{25AA}-\x{25FE}\x{2B05}-\x{2B07}\x{2B1B}-\x{2B1C}\x{3030}\x{303D}\x{3297}\x{3299}\x{2139}\x{2328}\x{23CF}\x{24C2}\x{25B6}\x{23E9}-\x{23F3}\x{23F8}-\x{23FA}\x{200D}\x{20E3}]'

# perl backs this gate. Without it the scan below silently finds nothing and the gate
# "passes" -- a fail-OPEN on the one rule this framework calls universal. Assert it.
if ! command -v perl >/dev/null 2>&1; then
  echo "  BLOCKED: perl not found, and Gate 2 (emoji scan) cannot run without it."
  echo "  Install perl, or this gate would silently pass every commit."
  exit 1
fi

# BSD grep has no -P, and `grep -nP` fails silently inside an if-condition — the gate
# never scanned anything on stock macOS. perl handles the \x{...} ranges natively.
if [ -n "$STAGED_FILES" ]; then
  while IFS= read -r file; do
    EMOJI_HITS=$(perl -CSD -ne 'print "$.: $_" if /'"$EMOJI_PATTERN"'/' "$file" 2>/dev/null || true)
    if [ -n "$EMOJI_HITS" ]; then
      echo "$EMOJI_HITS"
      echo "  BLOCKED: $file contains emojis or icons."
      echo "  Zero emojis allowed — plain text only."
      echo "  See <vault-root>/Oliver/Project Repos/OliverCode/core/contracts/NO_ICONS_STANDARD.md"
      exit 1
    fi
  done <<< "$STAGED_FILES"
fi

echo "  Gate 2 passed."

# ─── Gate 3: Archived content ─────────────────────────────────────────────────
# These repos hold current state only. A superseded file gets deleted or replaced,
# never parked in an Archive/ folder or beside its replacement as "-old" -- git
# already holds every past version, so a second copy on disk is a copy nothing
# keeps in sync, and the reader cannot tell which one is live.
#
# "remove don't archive" existed as instruction text in the deep-review skill for
# months while three archive trees accumulated anyway. Instruction text is what
# gets skipped; this is the gate.
echo "[pre-commit] Gate 3/4: Archived-content scan..."

# Matched as a whole PATH SEGMENT, never a substring: a file legitimately titled
# "Legacy Modernization Intelligence" is prose about legacy systems, not an archive.
ARCHIVE_SEGMENTS='^(_?[Aa]rchive[ds]?|[Ll]egacy|[Dd]eprecated|[Oo]utdated|_?[Bb]ackups?|[Oo]ld)$'
# Suffixes that mark a file as a superseded copy of its neighbour.
# "copy" is deliberately NOT here. In this vault copy means written copy -- "Slide
# Copy", "Website Services Copy" -- so matching it blocked 30-plus live files on
# the first run.
ARCHIVE_SUFFIX='(\.bak|~|[ _-]old|[ _-]backup|[ _-]deprecated|[ _-]superseded)(\.[A-Za-z0-9]+)?$'

# Deliberate exceptions. Each is a permanent record by decision, not drift.
#   Past To Dos/  - the weekly-task archive the vault's CLAUDE.md calls permanent
is_archive_exempt() {
  case "$1" in
    *"Past To Dos/"*) return 0 ;;
  esac
  return 1
}

if [ -n "$STAGED_FILES" ]; then
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    is_archive_exempt "$file" && continue

    # Any directory segment that names an archive.
    printf '%s\n' "$file" | tr '/' '\n' | grep -qE "$ARCHIVE_SEGMENTS" && {
      echo "  BLOCKED: $file sits under a directory that names an archive."
      echo "  This repo holds current state only. Delete the superseded copy --"
      echo "  git history is the archive. If it is genuinely still live, rename the"
      echo "  directory to say what it holds."
      exit 1
    }

    # A filename marked as a superseded copy.
    if printf '%s\n' "${file##*/}" | grep -qE "$ARCHIVE_SUFFIX"; then
      echo "  BLOCKED: $file is named as a superseded copy."
      echo "  Replace the file it supersedes instead of committing both; git keeps"
      echo "  the previous version."
      exit 1
    fi
  done <<< "$STAGED_FILES"
fi

echo "  Gate 3 passed."

# ─── Gate 4: Writing clarity (asd-ste100) ─────────────────────────────────────
# SKILL.md and CLAUDE.md are agent-parsed instructions, not human-read prose --
# a dense sentence in one caused a real skill-matching bug (SKILLS-PLACEMENT.md's
# ACT-3). Strict mode: full default ste-lint, no rule disabled, except a repo's own
# named per-file exemptions (see .githooks/ste-exemptions below) for a documented,
# checked false positive -- e.g. a real sheet-column name colliding with a real
# CLI-subcommand name under synonym-rotation's whole-file scope, where renaming
# either would misdescribe the real thing it names.
#
# The linter is a personal vendor install (npx skills add danyuchn/asd-ste100-skill),
# not vendored in-repo -- skip cleanly on a machine or clone that lacks it rather
# than blocking every commit.
STE_LINT=""
for candidate in "$HOME/.claude/skills/asd-ste100/scripts/ste-lint.py" "$HOME/.agents/skills/asd-ste100/scripts/ste-lint.py"; do
  [ -f "$candidate" ] && STE_LINT="$candidate" && break
done

# ste-lint.py counts sentence length one physical line at a time, so a hard-wrapped
# paragraph never trips the long-sentence cap (STE-JOIN-1 in OliverCode's
# docs/DECISIONS.md). ste-lint-joined.py joins soft-wrapped lines first and keeps the
# line numbers. sync-hooks installs it beside this hook. OliverCode's own hook reads
# the template copy.
STE_JOIN=""
for candidate in "$HOOK_DIR/ste-lint-joined.py" "$REPO_ROOT/core/templates/project/ste-lint-joined.py"; do
  [ -f "$candidate" ] && STE_JOIN="$candidate" && break
done

# path:rule pairs exempted from strict mode, one per accepted case. Lives outside
# this template (sync-hooks overwrites this file wholesale) in a plain per-repo
# file so an exemption survives every future hook sync untouched.
STE_EXEMPTIONS=""
STE_EXEMPTIONS_FILE="$REPO_ROOT/.githooks/ste-exemptions"
[ -f "$STE_EXEMPTIONS_FILE" ] && STE_EXEMPTIONS="$(cat "$STE_EXEMPTIONS_FILE")"

if [ -z "$STE_LINT" ] || ! command -v python3 >/dev/null 2>&1; then
  echo "[pre-commit] Gate 4/4: Writing clarity (asd-ste100)... skipped (ste-lint.py or python3 not found on this machine)."
else
  echo "[pre-commit] Gate 4/4: Writing clarity (asd-ste100)..."
  CLARITY_FAILED=0
  HAVE_JQ=0
  command -v jq >/dev/null 2>&1 && HAVE_JQ=1
  if [ -n "$STAGED_FILES" ]; then
    while IFS= read -r file; do
      case "${file##*/}" in
        SKILL.md|CLAUDE.md) [ -f "$file" ] || continue ;;
        *) continue ;;
      esac
      if [ -z "$STE_JOIN" ]; then
        echo "  BLOCKED: $file needs ste-lint-joined.py, which is missing from $HOOK_DIR."
        echo "  Without it, hard-wrapped prose passes the long-sentence cap unchecked."
        echo "  Run: olivercode sync-hooks"
        exit 1
      fi
      disable_rules=""
      while IFS=: read -r ex_path ex_rule; do
        [ -z "$ex_path" ] && continue
        [ "$ex_path" = "$file" ] && disable_rules="${disable_rules:+$disable_rules,}$ex_rule"
      done <<< "$STE_EXEMPTIONS"
      lint_args=(--json)
      [ -n "$disable_rules" ] && lint_args=(--disable "$disable_rules" --json)
      # Decide pass/fail from --json first, so a clean file (the common case) costs
      # one summary line instead of ste-lint's full per-finding dump -- that dump
      # was repeating in full on every commit for every staged file regardless of
      # whether it was actually blocking, real token waste on any commit touching
      # more than a couple of SKILL.md/CLAUDE.md files.
      JSON_OUT="$(python3 "$STE_JOIN" "$STE_LINT" "${lint_args[@]}" "$file" 2>&1)" && EXIT_CODE=0 || EXIT_CODE=$?
      if [ "$EXIT_CODE" -ne 0 ]; then
        CLARITY_FAILED=1
        # Re-run in plain mode so the failing file gets full fix-it detail.
        if [ -n "$disable_rules" ]; then
          python3 "$STE_JOIN" "$STE_LINT" --disable "$disable_rules" "$file" || true
        else
          python3 "$STE_JOIN" "$STE_LINT" "$file" || true
        fi
      elif [ "$HAVE_JQ" -eq 1 ]; then
        soft=$(printf '%s' "$JSON_OUT" | jq -r '.count')
        echo "  $file: $soft soft violation(s) (0 hard) -- not blocking."
      fi
    done <<< "$STAGED_FILES"
  fi
  if [ "$CLARITY_FAILED" -eq 1 ]; then
    echo "  BLOCKED: one or more SKILL.md/CLAUDE.md files fail asd-ste100 strict mode (see output above)."
    echo "  Fix the flagged sentences, then re-commit."
    exit 1
  fi
  echo "  Gate 4 passed."
fi

# ─── All gates passed ─────────────────────────────────────────────────────────
echo "[pre-commit] All 4 gates passed."
exit 0
