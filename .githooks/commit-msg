#!/usr/bin/env bash
# OliverCode commit-msg hook. Block = no commit.
# Generated by OliverCode's scripts/build-hooks.py from core/hooks/. Edit
# gates/commit-msg.sh there and rebuild; a hand edit here fails validation.
# Requires a story reference (#<number>) in every commit message.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

# STORY-REF-1. Every commit names the story it serves, so the history shows who did what and why.
# Git passes the message file as $1. Reading it can fail, and a hook that cannot read the
# message must block the commit and never let it through unchecked.
MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -r "$MSG_FILE" ]; then
  echo "[commit-msg] BLOCKED: cannot read the commit message file (${MSG_FILE:-none given}), so no story reference can be checked."
  exit 1
fi

# An owner opts a repo out by creating .githooks/commit-msg.optout. The hook never creates it,
# and every commit it lets through says so.
if [ -e "$HOOK_DIR/commit-msg.optout" ]; then
  echo "[commit-msg] Story reference check is off: $HOOK_DIR/commit-msg.optout exists."
  exit 0
fi

# What git keeps depends on how the message was made, and the hook receives the file before
# git cleans it. With -m or -F, git keeps every line, so a message that opens with "#53 fix" keeps
# its reference. With an editor, git writes a template of comment lines (the first begins
# "Please enter the commit message") and drops each comment line from the final message, so a
# reference inside one does not count. The hook reads that template marker to tell the two apart.
COMMENT_CHAR="$(git config --get core.commentChar 2>/dev/null || true)"
case "$COMMENT_CHAR" in ""|auto) COMMENT_CHAR="#" ;; esac
if grep -qF "$COMMENT_CHAR Please enter the commit message" "$MSG_FILE"; then
  MESSAGE="$(awk -v c="$COMMENT_CHAR" '
    $0 == c " ------------------------ >8 ------------------------" { exit }
    index($0, c) != 1 { print }' "$MSG_FILE")"
else
  MESSAGE="$(cat "$MSG_FILE")"
fi
SUBJECT="$(printf '%s\n' "$MESSAGE" | sed -n '/[^[:space:]]/{p;q;}')"

# Merge, revert and autosquash commits carry the message of work that already has a reference.
# The first commit of a repo has no story to name yet.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi
if ! git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  exit 0
fi

# A reference is a standalone # and a positive number that ends the token: "(#53)", "#53 fix",
# "Story: #53" or "org/repo#53". A hex colour such as #123abc, "Fix 5#3", "&#39;" and "#0" do not count.
TOKEN_END='([^[:alnum:]_]|$)'
NUMBER='#0*[1-9][0-9]*'
if printf '%s\n' "$MESSAGE" | grep -Eq "(^|[^[:alnum:]_/#&])${NUMBER}${TOKEN_END}|[[:alnum:]_.-]+/[[:alnum:]_.-]+${NUMBER}${TOKEN_END}"; then
  exit 0
fi

echo "[commit-msg] BLOCKED: the commit message names no story."
echo "  Add the story number, for example \"Fix the sync (#53)\" or a line \"Story: #53\"."
echo "  Merge, revert, fixup/squash commits and a repo's first commit are exempt."
echo "  To turn the check off for a repo, the owner creates $HOOK_DIR/commit-msg.optout (docs/GATES.md)."
exit 1
