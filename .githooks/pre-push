#!/usr/bin/env bash
# OliverCode pre-push hook. Block = no push.
# Generated by OliverCode's scripts/build-hooks.py from core/hooks/. Edit pre-push.sh and
# secret-patterns.sh there and rebuild; a hand edit here fails validation.
# Gate 1 refuses a history rewrite of an existing remote ref. Gate 2 scans every commit
# the push sends for secrets, including a secret added and removed inside the range.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ZERO_SHA="0000000000000000000000000000000000000000"
REMOTE="${1:-}"   # git passes the remote's name, or the URL when the push names one
PUSH_INPUT="$(cat)"
VIOLATIONS=0

SECRET_PATTERNS=(
  '[A-Za-z0-9_]{20,}:[A-Za-z0-9_\-]{30,}'   # Colon-separated tokens (bot tokens)
  'sk-[A-Za-z0-9]{20,}'                        # OpenAI/Anthropic-style keys
  'ghp_[A-Za-z0-9]{36}'                        # GitHub personal access tokens
  'eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+'  # JWT tokens
  '(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}'   # AWS access key id -- a bare AKIA... has no secret-named var to catch it
  'xox[baprs]-[0-9A-Za-z-]{10,}'               # Slack tokens (hyphens, so the alnum rule below misses them)
  '(sk|rk)_live_[0-9A-Za-z]{20,}'              # Stripe LIVE keys (underscore, not the sk- shape above). test keys deliberately allowed -- they appear in docs
  'AIza[0-9A-Za-z_-]{35}'                      # Google API key
  'npm_[0-9A-Za-z]{36}'                        # npm access token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'         # Private keys (RSA/EC/DSA/OPENSSH/PKCS8) — matches "BEGIN <TYPE> PRIVATE KEY"
  '(TOKEN|SECRET|KEY|PASSWORD|PASSWD|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|AUTH|CREDENTIAL|token|secret|key|password|passwd|api_?key|access_?key|auth|credential)["'\'':= ]+[A-Za-z0-9]{20,}'  # Secret-named var assigned a 20+ char alphanumeric value (a bare hex-blob pattern false-positives on every git SHA/lockfile hash)
)

echo "[pre-push] Gate 1/2: force-push / history-rewrite check..."
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue    # deleting a ref -- nothing to check
  [ "$remote_sha" = "$ZERO_SHA" ] && continue   # new ref -- nothing to rewrite
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    if [ "${ALLOW_FORCE_PUSH:-}" != "1" ]; then
      echo "  BLOCKED: $remote_ref would be force-pushed (history rewrite) -- $remote_sha is not an ancestor of $local_sha."
      echo "  If this is deliberate: ALLOW_FORCE_PUSH=1 git push ..."
      VIOLATIONS=$((VIOLATIONS + 1))
    fi
  fi
done <<< "$PUSH_INPUT"

if [ $VIOLATIONS -gt 0 ]; then
  echo "PUSH BLOCKED: $VIOLATIONS force-push/history-rewrite issue(s)."
  exit 1
fi
echo "  Gate 1 passed."

echo "[pre-push] Gate 2/2: Secret scan on every commit being pushed..."
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue
  # --cc shows the lines a merge commit itself adds, which plain -p leaves out.
  if [ "$remote_sha" != "$ZERO_SHA" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    PATCHES="$(git log -p --cc --format= "$remote_sha..$local_sha" -- 2>/dev/null || true)"
  else
    # A new ref, or a remote commit this clone lacks: scan every commit this remote's
    # tracking refs lack. A push to a bare URL matches none, so it scans the whole history.
    PATCHES="$(git log -p --cc --format= "$local_sha" --not --remotes="$REMOTE" -- 2>/dev/null || true)"
  fi
  [ -z "$PATCHES" ] && continue
  for pattern in "${SECRET_PATTERNS[@]}"; do
    HIT="$(printf '%s\n' "$PATCHES" | grep -nE -e "$pattern" | grep -E '^[0-9]+:\+' || true)"
    if [ -n "$HIT" ]; then
      printf '%s\n' "$HIT" | sed -n '1,3p'
      echo "  BLOCKED: $remote_ref push range matches secret pattern: $pattern"
      VIOLATIONS=$((VIOLATIONS + 1))
    fi
  done
done <<< "$PUSH_INPUT"

if [ $VIOLATIONS -gt 0 ]; then
  echo "PUSH BLOCKED: $VIOLATIONS potential secret leak(s) in the push range."
  exit 1
fi
echo "  Gate 2 passed."
echo "[pre-push] All gates passed."
exit 0
