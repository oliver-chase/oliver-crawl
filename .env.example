# ─── oliver-crawl ────────────────────────────────────────────────────────────
# EVERY variable here is optional. With none of them set, the own lane (lane 1)
# still works completely: it needs no keys and costs nothing. These only
# configure identity and the optional vendor lane (lane 2).

# Identity sent to origins. Please set this to YOUR bot — robots.txt rules key
# off it, and an origin can neither allow nor block you if every deployment
# claims the same name.
OLIVER_CRAWL_USER_AGENT="MyBot/1.0 (+https://mysite.example/bot)"

# ─── Lane 2: vendor APIs (all optional) ──────────────────────────────────────
# A missing key disables THAT rung only. No keys at all = lane 2 reports
# 'no_lane_available' instead of failing, and lane 1 carries on regardless.
# The bare names (FIRECRAWL_API_KEY, ...) are read as fallbacks, so a repo that
# already has them set does not need to rename anything.

OLIVER_CRAWL_FIRECRAWL_KEY=
OLIVER_CRAWL_APIFY_TOKEN=

# Order to try vendor rungs in. Default: firecrawl,apify
OLIVER_CRAWL_VENDOR_ORDER=firecrawl,apify

# ─── Search providers (separate surface from the scrape rungs) ───────────────
# Search is always paid — there is no free rung here, unlike lane 1. With no
# key set, crawler.search() reports 'no_provider_configured' rather than
# silently returning nothing.
OLIVER_CRAWL_TAVILY_KEY=
OLIVER_CRAWL_SERPER_KEY=

# Serper first by default: roughly 5x cheaper per call than Tavily for the
# same corroboration job, and it returns Google results.
OLIVER_CRAWL_SEARCH_ORDER=serper,tavily

# Free local-Chromium render rung. Requires `npx playwright install chromium`
# once on the machine. On a serverless/edge deploy that can't run a browser,
# leave this off and rely on OLIVER_CRAWL's remote-render config instead.
OLIVER_CRAWL_LOCAL_RENDER=0
